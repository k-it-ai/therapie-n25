---
import { content, practice, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const t = content[Astro.props.lang];
---
<a class="call" href={practice.phoneHref} data-call aria-label={`${t.ui.call}: ${practice.phone}`}>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 3.5l2.6 3.4c.4.5.4 1.3-.1 1.8l-1.5 1.5c1 2.3 2.9 4.2 5.2 5.2l1.5-1.5c.5-.5 1.3-.5 1.8-.1l3.4 2.6c.6.4.7 1.3.2 1.9l-1.6 1.9c-.6.7-1.6 1-2.5.7C9.9 19.3 4.7 14.1 3.1 8.4c-.3-.9 0-1.9.7-2.5l1.9-1.6c.6-.5 1.5-.4 1.9.2z" fill="currentColor"/></svg>
  <span class="label">{t.ui.call}</span>
</a>

<style>
  .call {
    position: fixed;
    right: clamp(1rem, 2.5vw, 2rem);
    bottom: clamp(1rem, 2.5vw, 2rem);
    z-index: 90;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.3rem;
    background: var(--ink);
    color: #fff;
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 999px;
    box-shadow: 0 14px 30px -14px rgba(46, 74, 95, 0.7);
    opacity: 0;
    transform: translateY(16px);
    pointer-events: none;
    transition: opacity 0.4s var(--ease), transform 0.4s var(--ease), background-color 0.25s;
  }
  .call.is-visible { opacity: 1; transform: none; pointer-events: auto; }
  .call:hover { background: #24394a; }
  .call svg { width: 18px; height: 18px; }
  @media (max-width: 599px) {
    .call { width: 56px; height: 56px; padding: 0; justify-content: center; }
    .call .label { display: none; }
    .call svg { width: 22px; height: 22px; }
  }
</style>
