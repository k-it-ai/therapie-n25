---
import { Picture, getImage } from 'astro:assets';
import { content, practice, type Lang } from '../i18n/content';
import { photos, type PhotoKey } from '../lib/photos';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];

// Screens wider than tall show the 'wide' set, upright screens (phones, upright tablets) the 'tall' set;
// 'both' slides belong to both sets. Turning the device switches the set.
// `pos` / `posTall` override the photo's default crop on wide / upright screens.
// `landscape`: a second photo of the same subject for screens wider than tall (the browser loads only one).
type Slide = { key: PhotoKey; set: 'both' | 'wide' | 'tall'; pos?: string; posTall?: string; landscape?: PhotoKey };
const slides: Slide[] = [
  { key: 'fassade', landscape: 'fassade-quer', set: 'both', pos: '50% 0%', posTall: '50% 30%' },
  { key: 'empfang', set: 'wide' },
  { key: 'therapieraum-hell', set: 'tall' },
  { key: 'therapieraum-bunt', set: 'both' },
  { key: 'therapieraum-erker', set: 'tall' },
  { key: 'trainingsraum', set: 'both' },
  { key: 'wartebereich', set: 'tall' },
  { key: 'empfang-flur', set: 'wide' },
  { key: 'gyrotonic', set: 'tall' },
];
// upright screens: landscape photos fill the height, so they are drawn about twice the screen width
const sizes = (key: PhotoKey) =>
  photos[key].src.width > photos[key].src.height ? '(orientation: portrait) 200vw, 100vw' : '100vw';
const position = ({ key, pos, posTall }: Slide) => {
  const base = pos ?? ('position' in photos[key] ? photos[key].position : '50% 50%');
  return `--pos:${base};--pos-tall:${posTall ?? base}`;
};
// art direction: <source> sets per orientation, so only the matching photo is downloaded
const LANDSCAPE = '(orientation: landscape)';
const variants = async (key: PhotoKey, widths: number[]) => {
  const { src } = photos[key];
  const fit = [...widths.filter((w) => w < src.width), src.width];
  return Promise.all((['avif', 'webp'] as const).map(async (format) => {
    const img = await getImage({ src, widths: fit, format });
    return { type: `image/${format}`, srcset: img.srcSet.attribute, src: img.src };
  }));
};
const art = await Promise.all(slides.map(async (s) => s.landscape && {
  landscape: await variants(s.landscape, [960, 1280, 1920, 2400, 3200]),
  portrait: await variants(s.key, [480, 720, 960, 1280, 1600]),
}));
// dot labels: position within the wide set ('tall' slides: within the tall set); the script relabels on rotation
const number = (i: number) => {
  const set = slides[i].set === 'tall' ? 'tall' : 'wide';
  return slides.slice(0, i + 1).filter((s) => s.set === 'both' || s.set === set).length;
};
---
<section class="hero" id="top" aria-roledescription="carousel" aria-label={t.hero.srTitle} data-carousel>
  <div class="slides" data-parallax-hero>
    {slides.map((slide, i) => (
      <div class={`slide slide--${slide.set}${i === 0 ? ' is-active' : ''}`} data-slide aria-hidden={i === 0 ? 'false' : 'true'}>
        {art[i] ? (
          <picture>
            {art[i].landscape.map((v) => <source media={LANDSCAPE} type={v.type} srcset={v.srcset} sizes="100vw" />)}
            {art[i].portrait.map((v) => <source type={v.type} srcset={v.srcset} sizes="100vw" />)}
            <img src={art[i].portrait[1].src} alt={photos[slide.key].alt[lang]}
                 width={photos[slide.key].src.width} height={photos[slide.key].src.height}
                 loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'low'}
                 decoding="async" style={position(slide)} />
          </picture>
        ) : <Picture
          src={photos[slide.key].src}
          alt={photos[slide.key].alt[lang]}
          widths={slide.set === 'tall' ? [480, 720, 960, 1280, 1600, 2133] : [960, 1280, 1920, 2400, 3200]}
          sizes={sizes(slide.key)}
          formats={['avif', 'webp']}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'low'}
          style={position(slide)}
        />}
      </div>
    ))}
  </div>

  <div class="hero-info">
    <h1>
      <span class="sr-only">Therapie N25 – </span>{t.hero.title}
    </h1>
    <p>
      {practice.street} <span aria-hidden="true">|</span> {practice.zip} {practice.city}
      <br />
      <a href={practice.phoneHref}>Tel. {practice.phone}</a>
    </p>
    <div class="controls">
      <div class="dots" role="group" aria-label={t.ui.slideGoto}>
        {slides.map((slide, i) => (
          <button type="button" class={`dot dot--${slide.set}`} data-dot={i}
                  aria-label={`${t.ui.slideGoto} ${number(i)}`}></button>
        ))}
      </div>
      <button type="button" class="pause" data-pause
              data-label-pause={t.ui.slidePause} data-label-play={t.ui.slidePlay}
              aria-label={t.ui.slidePause}>
        <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 3h3v10H4zM9 3h3v10H9z" fill="currentColor"/></svg>
        <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5v11l9-5.5z" fill="currentColor"/></svg>
      </button>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 2;
    height: calc(100svh - var(--header-h) - var(--safe-t));
    min-height: 520px;
    max-height: 1100px;
    overflow: hidden;
    background: var(--apricot-100);
  }
  /* no overscan: the parallax only moves the photos down, so nothing above the top edge is ever needed */
  .slides { position: absolute; inset: 0; will-change: transform; }
  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1s var(--ease);
  }
  .slide.is-active { opacity: 1; }
  .slide--tall, .dot.dot--tall { display: none; }
  @media (orientation: portrait) {
    .slide--tall { display: block; }
    .dot.dot--tall { display: grid; }
    .slide--wide, .dot.dot--wide { display: none; }
  }
  .slide :global(picture), .slide :global(img) { width: 100%; height: 100%; }
  .slide :global(img) {
    object-fit: cover;
    object-position: var(--pos);
    /* the slow zoom grows from the top edge, so the top of each photo stays in view */
    transform-origin: 50% 0;
    transform: scale(1.04);
    transition: transform 7s linear;
  }
  .slide.is-zoomed :global(img) { transform: scale(1.12); }
  @media (orientation: portrait) {
    .slide :global(img) { object-position: var(--pos-tall); }
  }

  .hero-info {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 1.4rem var(--gutter) 0.9rem;
    text-align: center;
    color: var(--ink);
    background: var(--apricot-300);
    background: color-mix(in srgb, var(--apricot-300) 86%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    line-height: 1.9;
    text-transform: uppercase;
  }
  h1 {
    font-size: clamp(1rem, 0.9rem + 0.6vw, 1.35rem);
    font-weight: 430;
    letter-spacing: 0.22em;
    margin-bottom: 0.4rem;
  }
  .hero-info p { margin: 0; }
  .hero-info a { text-decoration: none; }
  @media (hover: hover) { .hero-info a:hover { text-decoration: underline; text-underline-offset: 3px; } }

  /* Slide markers: a compact row at the bottom of the band */
  .controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin: 0.3rem 0 -0.45rem;
  }
  .dots { display: flex; gap: 0.15rem; }
  .dot {
    width: 28px; height: 28px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .dot::before {
    content: '';
    width: 18px; height: 2px;
    background: rgba(46, 74, 95, 0.35);
    transition: background-color 0.4s var(--ease), width 0.4s var(--ease);
  }
  .dot[aria-current='true']::before { background: var(--ink); width: 26px; }
  @media (forced-colors: active) {
    .dot::before { background: CanvasText; }
    .dot[aria-current='true']::before { background: Highlight; }
  }
  .pause {
    width: 28px; height: 28px;
    display: grid; place-items: center;
    border: 0; background: none; padding: 0;
    color: var(--ink); cursor: pointer;
  }
  .pause svg { width: 12px; height: 12px; }
  .pause .i-play { display: none; }
  .pause.is-paused .i-play { display: block; }
  .pause.is-paused .i-pause { display: none; }

  /* Mobile: photo on top, band below. The band's colour reaches the screen bottom (lvh),
     its text stays above the browser bars (svh). */
  @media (max-width: 699px) {
    .hero {
      height: calc(100vh - var(--header-h));
      height: calc(100lvh - var(--header-h) - var(--safe-t));
      min-height: 480px;
      max-height: none;
      display: flex;
      flex-direction: column;
    }
    .slides { position: relative; inset: auto; flex: 1; min-height: 0; }
    .hero-info {
      position: relative;
      backdrop-filter: none;
      background: var(--apricot-300);
      font-size: 0.78rem;
      padding-bottom: 0.9rem;
      padding-bottom: calc(0.9rem + 100lvh - 100svh);
    }
  }
</style>
