---
import { Picture, Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import { content, type Lang } from '../i18n/content';
import { photos } from '../lib/photos';
import dovLogo from '../assets/dov-logo.png';
import kidsLogo from '../assets/kindersymbol.png';

interface Props { lang: Lang }
const { lang } = Astro.props;
const a = content[lang].about;
const photo = photos['empfang-detail'];
---
<section class="section about" id="ueber-uns" aria-labelledby="ueber-uns-title">
  <div class="wrap">
    <SectionHead id="ueber-uns" title={a.heading} tagline={a.tagline} />

    <div class="split">
      <div class="text reveal">
        {a.paragraphs.map((p, i) => <p class={i === 0 ? 'lead' : ''}>{p}</p>)}
      </div>
      <div class="visual reveal">
        <div class="frame" data-parallax>
          <Picture src={photo.src} alt={photo.alt[lang]} widths={[400, 600, 800, 1100]}
            sizes="(min-width: 900px) 400px, 80vw" formats={['avif', 'webp']} />
        </div>
      </div>
    </div>

    <blockquote class="quote reveal">
      <p>{a.quote}</p>
    </blockquote>

    <ul class="badges reveal">
      <li>
        <a href="https://www.osteopathie.de/" rel="noopener" target="_blank">
          <Image src={dovLogo} alt={a.dovAlt} width={96} densities={[1, 2]} />
          <span>{a.dov}</span>
        </a>
      </li>
      <li>
        <Image src={kidsLogo} alt={a.kidsAlt} width={88} densities={[1, 2]} />
        <span>{a.kids}</span>
      </li>
    </ul>
  </div>
</section>

<style>
  .text { max-width: 33rem; justify-self: end; }
  .lead {
    font-size: clamp(1.15rem, 1.05rem + 0.45vw, 1.4rem);
    line-height: 1.55;
    color: var(--ink);
    font-weight: 350;
  }
  .visual { width: min(100%, 400px); }
  .visual .frame { aspect-ratio: 4 / 5; }
  @media (max-width: 899px) {
    .text { justify-self: start; }
    .visual { justify-self: center; width: min(100%, 340px); }
  }

  .quote {
    position: relative;
    z-index: 1;
    margin: clamp(4rem, 9vw, 7rem) auto clamp(3rem, 7vw, 4.5rem);
    max-width: 40rem;
    padding: 2rem 1rem;
    background: var(--paper);
    text-align: center;
  }
  .quote p {
    margin: 0;
    font-size: clamp(1.5rem, 1.1rem + 1.8vw, 2.5rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1.3;
    color: var(--ink);
    text-wrap: balance;
  }

  .badges {
    position: relative;
    z-index: 1;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem clamp(3rem, 10vw, 8rem);
    background: var(--paper);
    width: fit-content;
    max-width: 100%;
    margin: 0 auto;
    padding: 1rem;
  }
  .badges li, .badges a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    max-width: 15rem;
    text-align: center;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--text-soft);
    text-decoration: none;
  }
  .badges img { width: 72px; height: auto; }
  .badges a:hover span { text-decoration: underline; text-underline-offset: 3px; }
</style>
