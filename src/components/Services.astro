---
import { Picture } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import Chevron from './Chevron.astro';
import { content, type Lang } from '../i18n/content';
import { photos } from '../lib/photos';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
const s = t.services;
---
<section class="section services" id="was-wir-tun" aria-labelledby="was-wir-tun-title">
  <div class="wrap">
    <SectionHead id="was-wir-tun" title={s.heading} tagline={s.tagline} />

    <ul class="core reveal">
      {s.core.map((c) => <li>{c}</li>)}
    </ul>

    <div class="items">
      {s.items.map((item, i) => {
        const p = photos[item.photo];
        return (
          <article class={`item${i % 2 ? ' item--flip' : ''}`} id={item.id} aria-labelledby={`${item.id}-title`} data-acc>
            <!-- phones/tablets: tap row that opens photo + text -->
            <h3 class="acc-head">
              <button type="button" class="acc-btn" aria-expanded="false" aria-controls={`${item.id}-panel`} data-acc-btn>
                <span id={`${item.id}-title`}>{item.title}</span>
                <Chevron />
              </button>
            </h3>
            <div class="acc-panel" id={`${item.id}-panel`} data-acc-panel>
              <div class="acc-inner">
                <div class="visual reveal">
                  <div class="frame" data-parallax>
                    <Picture src={p.src} alt={p.alt[lang]} widths={[480, 720, 960, 1280, 1600, 2000]}
                      sizes="(min-width: 900px) 540px, 100vw" formats={['avif', 'webp']}
                      style={`object-position:${'position' in p ? p.position : '50% 50%'}`} />
                  </div>
                  <p class="plate" aria-hidden="true">{item.title}</p>
                </div>
                <div class="text reveal">
                  <p class="block-sub">{item.subtitle}</p>
                  {item.intro.map((para) => <p>{para}</p>)}
                  {item.list.length > 0 && (
                    <ul class="dot-list">{item.list.map((li) => <li>{li}</li>)}</ul>
                  )}
                  {'outro' in item && <p class="outro">{item.outro}</p>}
                  {item.more.length > 0 && (
                    <details class="more">
                      <summary>
                        <span class="label-more">{t.ui.readMore}</span>
                        <span class="label-less">{t.ui.readLess}</span>
                        <Chevron />
                      </summary>
                      <div class="more-body">{item.more.map((para) => <p>{para}</p>)}</div>
                    </details>
                  )}
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  /* Core qualifications: a quiet centred list */
  .core {
    list-style: none;
    position: relative;
    z-index: 1;
    width: fit-content;
    max-width: 40rem;
    margin: -1.5rem auto clamp(4rem, 9vw, 7rem);
    padding: 0.5rem 1.5rem;
    background: var(--paper);
    text-align: center;
    color: var(--ink);
    font-size: clamp(1rem, 0.96rem + 0.25vw, 1.12rem);
    line-height: 1.5;
  }
  .core li { padding: 0.45rem 0; text-wrap: balance; }
  .core li::before {
    content: '';
    display: inline-block;
    width: 6px; height: 6px;
    margin: 0 0.75rem 0.18em 0;
    border-radius: 50%;
    background: var(--apricot-400);
    vertical-align: middle;
  }

  /* phones: left-aligned with hanging bullets, easier to read when lines wrap */
  @media (max-width: 599px) {
    .core { text-align: left; padding-inline: 0.5rem; }
    .core li { padding-left: 1.15rem; text-indent: -1.15rem; }
  }

  .items { display: grid; gap: clamp(4.5rem, 10vw, 8rem); }

  .visual { position: relative; }
  .frame { aspect-ratio: 4 / 5; }
  .item:nth-child(3) .frame { aspect-ratio: 5 / 4; }
  .plate {
    position: absolute;
    left: clamp(-1.5rem, -2vw, -0.5rem);
    bottom: clamp(1.25rem, 3vw, 2rem);
    max-width: 80%;
    margin: 0;
    padding: 0.9rem 1.4rem;
    background: var(--paper);
    border-left: 3px solid var(--apricot-400);
    box-shadow: 0 18px 40px -26px rgba(46, 74, 95, 0.45);
    color: var(--ink);
    font-size: clamp(1.05rem, 0.95rem + 0.6vw, 1.45rem);
    font-weight: 380;
    line-height: 1.3;
  }
  .item--flip .plate { left: auto; right: clamp(-1.5rem, -2vw, -0.5rem); }
  .text { max-width: 34rem; }
  .outro { margin-top: 1.25rem; }
  .more { margin-top: 0.5rem; }
  .more-body { padding-top: 0.75rem; }

  /* ---- Desktop: photo and text side by side, no accordion ---- */
  @media (min-width: 900px) {
    .acc-head { display: none; }
    .acc-inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: var(--col-gap);
      align-items: center;
    }
    .item--flip .acc-inner > :first-child { order: 2; }
  }

  /* ---- Phones & tablets: one row per treatment, tap to open ---- */
  @media (max-width: 899px) {
    .items { gap: 0; border-top: 1px solid var(--apricot-100); }
    .item { display: block; border-bottom: 1px solid var(--apricot-100); }
    .acc-head { margin: 0; font: inherit; }
    .acc-btn {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      width: 100%;
      padding: 1.25rem 0.25rem;
      border: 0;
      background: none;
      cursor: pointer;
      text-align: left;
      color: var(--ink);
      font-size: 1.05rem;
      font-weight: 450;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      line-height: 1.35;
    }
    .acc-btn :global(.chev) { width: 1rem; height: 1rem; flex: none; transition: transform 0.35s var(--ease); }
    .acc-btn[aria-expanded='true'] :global(.chev) { transform: rotate(180deg); }
    .plate { display: none; }
    .acc-inner { display: grid; gap: 1.5rem; padding-bottom: 2rem; }
    .frame, .item:nth-child(3) .frame { aspect-ratio: 3 / 2; }
    .text { max-width: 40rem; }

    /* collapsed by default once JavaScript runs; without JS everything stays open */
    :global(.js) .acc-panel {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.45s var(--ease);
    }
    :global(.js) .acc-panel > .acc-inner { overflow: hidden; min-height: 0; padding-bottom: 0; transition: padding 0.45s var(--ease); }
    :global(.js) .acc-panel.is-open { grid-template-rows: 1fr; }
    :global(.js) .acc-panel.is-open > .acc-inner { padding-bottom: 2rem; }
    /* no scroll fade inside the tap panels */
    :global(.js) .acc-panel :global(.reveal) { opacity: 1; transform: none; }
  }
</style>
