---
import SectionHead from './SectionHead.astro';
import MapSvg from '../assets/map.svg';
import { content, practice, type Lang } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
const c = t.contact;
const q = encodeURIComponent(practice.mapsQuery);
const addr = encodeURIComponent(`${practice.street}, ${practice.zip} ${practice.city}`);
const links = {
  // iOS/iPadOS 18.4+: hands the route to the app chosen under Settings › Apps › Default Apps › Navigation
  geoNav: `geo-navigation:///directions?destination=${addr}`,
  google: `https://www.google.com/maps/dir/?api=1&destination=${q}`,
  apple: `https://maps.apple.com/?daddr=${q}`,
  geo: `geo:0,0?q=${q}`,
};
---
<section class="section contact" id="anfahrt" aria-labelledby="anfahrt-title">
  <div class="wrap">
    <SectionHead id="anfahrt" title={c.heading} tagline={c.tagline} />

    <div class="split contact-grid">
      <div class="info reveal">
        <div class="group">
          <h3 class="block-title">{c.addressHeading}</h3>
          <address>
            {practice.name}<br />
            {practice.street}<br />
            {practice.zip} {practice.city}
          </address>
          <p class="phone">
            <span class="k">{c.phoneLabel}</span>
            <a href={practice.phoneHref}>{practice.phone}</a><br />
            <span class="k">{c.emailLabel}</span>
            <a href={`mailto:${practice.email}`}>{practice.email}</a>
          </p>
          <p class="note email-note">{c.emailNote}</p>
        </div>

        <div class="group">
          <h3 class="block-title">{c.hoursHeading}</h3>
          <dl class="hours">
            {c.hours.map((h) => (<><dt>{h.days}</dt><dd>{h.time}</dd></>))}
          </dl>
          <p class="note">{c.hoursNote}</p>
        </div>

        <div class="group">
          <h3 class="block-title">{c.transitHeading}</h3>
          <ul class="transit">
            {c.transit.map((tr) => (
              <li>
                <span class={`badge badge-${tr.kind}`}>{tr.line}</span>
                <span>{tr.text}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <figure class="map reveal">
        <MapSvg class="map-svg" aria-label={c.mapAlt} />
        <div class="route-wrap">
          <a class="btn route" href={links.google} data-route
             data-apple={links.apple} data-geo={links.geo} data-geonav={links.geoNav} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5c-3.9 0-7 3-7 6.9 0 5.1 7 12.1 7 12.1s7-7 7-12.1c0-3.9-3.1-6.9-7-6.9z" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="9.5" r="2.4" fill="currentColor"/></svg>
            {c.route}
          </a>
          <!-- older iPhones/iPads (before iOS 18.4) and in-app browsers of social apps: the visitor picks the app -->
          <div class="route-menu" id={`route-menu-${lang}`} data-route-menu hidden>
            <a href={links.apple} target="_blank" rel="noopener">{c.routeApple}</a>
            <a href={links.google} target="_blank" rel="noopener">{c.routeGoogle}</a>
          </div>
        </div>
        <figcaption class="osm">
          <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">{c.mapCredit}</a>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .contact-grid { align-items: stretch; }
  .info { max-width: 30rem; justify-self: end; width: 100%; }
  @media (max-width: 899px) { .info { justify-self: start; max-width: none; } }
  .group { margin-bottom: 2.25rem; }
  .group:last-child { margin-bottom: 0; }
  .group .block-title { font-size: 0.95rem; margin-bottom: 0.6rem; }
  address { font-style: normal; color: var(--ink); font-size: 1.1rem; line-height: 1.6; margin-bottom: 0.6rem; }
  .phone { margin: 0; }
  .email-note { margin-top: 0.4rem; }
  .k { display: inline-block; min-width: 5.5rem; color: var(--text-soft); }
  .phone a { color: var(--ink); font-size: 1.1rem; text-decoration-color: var(--apricot-400); text-underline-offset: 4px; }

  .hours { display: grid; grid-template-columns: auto 1fr; gap: 0.2rem 1.5rem; margin: 0 0 0.4rem; color: var(--ink); }
  .hours dd { margin: 0; }
  .note { color: var(--text-soft); font-size: 0.95rem; margin: 0; }

  .transit { list-style: none; display: grid; gap: 0.6rem; }
  .transit li { display: flex; align-items: center; gap: 0.8rem; }
  .badge {
    flex: none;
    min-width: 2.6rem;
    padding: 0.1rem 0.5rem;
    color: #fff;
    font-size: 0.82rem;
    font-weight: 600;
    text-align: center;
    letter-spacing: 0.03em;
    border-radius: 3px;
    white-space: nowrap;
  }
  .badge-u { background: #3c7233; }
  .badge-tram { background: #c4161c; }
  .badge-bus { background: #0d5c6b; }

  /* Static map with the route button on it */
  .map {
    position: relative;
    margin: 0;
    min-height: 460px;
    background: #f3eee8;
    overflow: hidden;
  }
  .map :global(.map-svg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .route-wrap {
    position: absolute;
    left: 1.25rem;
    bottom: 1.25rem;
  }
  .route { box-shadow: 0 14px 30px -16px rgba(46, 74, 95, 0.8); }
  @media (hover: hover) { .route:hover { background: var(--paper); } }
  .route-menu {
    position: absolute;
    left: 0;
    bottom: calc(100% + 0.5rem);
    min-width: 100%;
    display: grid;
    background: var(--paper);
    box-shadow: 0 14px 30px -16px rgba(46, 74, 95, 0.8);
  }
  .route-menu[hidden] { display: none; }
  .route-menu a {
    padding: 0.85rem 1.5rem;
    color: var(--ink);
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }
  .route-menu a + a { border-top: 1px solid var(--apricot-100); }
  @media (hover: hover) { .route-menu a:hover { background: var(--apricot-50); } }
  /* credit sits on the map itself; a soft halo in the map colour keeps it readable over streets */
  .osm {
    position: absolute;
    right: 0.6rem;
    bottom: 0.35rem;
    font-size: 0.75rem;
    line-height: 1.4;
    text-shadow: 0 0 2px #f3eee8, 0 0 4px #f3eee8, 0 0 8px #f3eee8;
  }
  .osm a { color: #8a8f94; text-decoration: none; }
  @media (hover: hover) { .osm a:hover { text-decoration: underline; } }
  /* phones/tablets: fixed height (aspect-ratio on a stretched grid item collapses in Safari) */
  @media (max-width: 899px) {
    .map { min-height: 0; height: clamp(340px, 92vw, 560px); align-self: start; }
  }
</style>
