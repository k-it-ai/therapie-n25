---
import { Picture, getImage } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import { content, type Lang } from '../i18n/content';
import { photos, type PhotoKey } from '../lib/photos';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
const r = t.rooms;

// Large versions for the lightbox
const large: Record<string, string> = {};
for (const room of r.items) {
  for (const key of room.photos as readonly PhotoKey[]) {
    const img = await getImage({ src: photos[key].src, width: 1800, format: 'webp', quality: 82 });
    large[key] = img.src;
  }
}
---
<section class="section rooms" id="praxisraeume" aria-labelledby="praxisraeume-title">
  <div class="wrap">
    <SectionHead id="praxisraeume" title={r.heading} tagline={r.tagline} />

    <div class="room-list">
      {r.items.map((room, i) => {
        const keys = room.photos as readonly PhotoKey[];
        return (
          <article class={`split room${i % 2 ? ' split--flip' : ''}`} id={room.id} aria-labelledby={`${room.id}-title`}>
            <div class="text reveal">
              <h3 class="block-title" id={`${room.id}-title`}>{room.title}</h3>
              <p class="room-text">{room.text}</p>
              <ul class="dot-list">{room.features.map((f) => <li>{f}</li>)}</ul>
            </div>

            <div class={`gallery reveal count-${keys.length}`}>
              {keys.length === 0 && (
                <div class="frame placeholder" data-placeholder="kinderraum">
                  <svg viewBox="0 0 48 48" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.5"><rect x="6" y="10" width="36" height="28" rx="2"/><circle cx="17" cy="20" r="3.5"/><path d="M6 33l11-9 8 6 6-4 11 8"/></g></svg>
                  <span>{t.ui.photoFollows}</span>
                </div>
              )}
              {keys.map((key, k) => (
                <a class="frame" href={large[key]} data-lightbox={room.id} data-parallax
                   aria-label={`${t.ui.enlarge}: ${photos[key].alt[lang]}`}>
                  <Picture src={photos[key].src} alt={photos[key].alt[lang]}
                    widths={k === 0 ? [480, 720, 960, 1280] : [320, 480, 640, 960]}
                    sizes={k === 0 ? '(min-width: 900px) 540px, 100vw' : '(min-width: 900px) 320px, 50vw'}
                    formats={['avif', 'webp']}
                    style={`object-position:${'position' in photos[key] ? photos[key].position : '50% 50%'}`} />
                </a>
              ))}
            </div>
          </article>
        );
      })}
    </div>
    <p class="credit">{r.credit}</p>
  </div>
</section>

<dialog class="lightbox" data-lightbox-dialog aria-label={r.heading}>
  <img data-lightbox-img alt="" />
  <button type="button" class="lb-close" data-lightbox-close aria-label={t.ui.close}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.6"/></svg>
  </button>
  <button type="button" class="lb-nav lb-prev" data-lightbox-prev aria-label="‹">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4l-8 8 8 8" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
  </button>
  <button type="button" class="lb-nav lb-next" data-lightbox-next aria-label="›">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4l8 8-8 8" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
  </button>
</dialog>

<style>
  .room-list { display: grid; gap: clamp(4.5rem, 10vw, 8rem); }
  .text { max-width: 32rem; }
  .split--flip .text { justify-self: start; }
  .room:not(.split--flip) .text { justify-self: end; }
  @media (max-width: 899px) { .room .text { justify-self: start !important; } }
  .room-text { margin-top: 1rem; }

  .gallery { display: grid; gap: 0.75rem; }
  .gallery .frame { display: block; cursor: zoom-in; }
  .count-3 { grid-template-columns: 1fr 1fr; }
  .count-3 .frame:first-child { grid-column: 1 / -1; aspect-ratio: 3 / 2; }
  .count-3 .frame:not(:first-child) { aspect-ratio: 1 / 1; }
  .count-1 .frame { aspect-ratio: 3 / 2; }
  .count-2 { grid-template-columns: 3fr 2fr; }
  .count-2 .frame { aspect-ratio: auto; height: clamp(300px, 36vw, 460px); }

  .gallery .placeholder {
    aspect-ratio: 3 / 2;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    cursor: default;
    background:
      repeating-linear-gradient(135deg, transparent 0 14px, color-mix(in srgb, var(--apricot-300) 18%, transparent) 14px 15px),
      var(--apricot-50);
    border: 1px dashed var(--apricot-300);
    color: var(--apricot-400);
  }
  .placeholder svg { width: 56px; }
  .placeholder span { color: var(--text-soft); font-style: italic; }

  .credit {
    position: relative;
    z-index: 1;
    width: fit-content;
    margin: clamp(3rem, 6vw, 4rem) auto 0;
    padding: 0.25rem 1rem;
    background: var(--paper);
    font-size: 0.82rem;
    color: var(--text-soft);
  }

  .lightbox {
    width: 100vw; height: 100vh;
    max-width: none; max-height: none;
    margin: 0; padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
  }
  .lightbox::backdrop { background: rgba(32, 44, 54, 0.88); backdrop-filter: blur(4px); }
  .lightbox[open] { display: grid; place-items: center; animation: lb-in 0.35s var(--ease); }
  .lightbox img {
    max-width: min(92vw, 1600px);
    max-height: 86vh;
    width: auto; height: auto;
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.6);
  }
  .lightbox button {
    position: absolute;
    width: 48px; height: 48px;
    display: grid; place-items: center;
    background: none; border: 0; color: #fff; cursor: pointer;
  }
  .lightbox button svg { width: 26px; height: 26px; }
  .lb-close { top: 1rem; right: 1rem; }
  .lb-prev { left: 0.5rem; top: 50%; translate: 0 -50%; }
  .lb-next { right: 0.5rem; top: 50%; translate: 0 -50%; }
  @keyframes lb-in { from { opacity: 0; } to { opacity: 1; } }
</style>
