---
import Wordmark from '../assets/n25-wordmark.svg';
import KossovIt from '../assets/kossov-it.svg';
import KossovItH from '../assets/kossov-it-h.svg';
import { content, practice, type Lang } from '../i18n/content';
import { url } from '../lib/url';

interface Props { lang: Lang; home: boolean }
const { lang, home } = Astro.props;
const t = content[lang];
const base = url(lang === 'de' ? '/' : '/en/');
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="inner">
    <a class="mark" href={home ? '#top' : base} aria-label={t.ui.backToTop}>
      <Wordmark aria-hidden="true" />
    </a>
    <p class="services">{t.footer.services}</p>
    <address>
      <span>{practice.street.toUpperCase()}</span><span class="sep" aria-hidden="true">|</span><span>{practice.zip} {practice.city.toUpperCase()}</span>
      <br />
      <a href={practice.phoneHref}>TEL.&nbsp;{practice.phone}</a>
    </address>
    <nav class="legal-links" aria-label={lang === 'de' ? 'Rechtliches' : 'Legal'}>
      <a href={url(t.footer.privacyHref)}>{t.footer.privacy}</a><span class="sep" aria-hidden="true">|</span><a href={url(t.footer.imprintHref)}>{t.footer.imprint}</a>
    </nav>
    <p class="copy">{t.footer.copyright} © {practice.since} – {year} {practice.name}</p>
  </div>
  <!-- Designer credit. Desktop: vertical mark on the right edge. Phones: own row at the bottom. -->
  <div class="credit credit--v">
    <span class="credit-line" aria-hidden="true"></span>
    <a href="https://kossov.it" target="_blank" rel="noopener"
       aria-label={lang === 'de' ? 'Webdesign: kossov.it (öffnet in neuem Tab)' : 'Web design: kossov.it (opens in a new tab)'}>
      <KossovIt aria-hidden="true" />
    </a>
  </div>
  <div class="credit credit--h">
    <a href="https://kossov.it" target="_blank" rel="noopener"
       aria-label={`${t.footer.webdesign} kossov.it (${lang === 'de' ? 'öffnet in neuem Tab' : 'opens in a new tab'})`}>
      <span class="credit-label" aria-hidden="true">{t.footer.webdesign}</span>
      <KossovItH aria-hidden="true" />
    </a>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    background: var(--apricot-300);
    color: var(--ink);
    text-align: center;
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    line-height: 2.1;
  }
  .inner { padding: 3.5rem var(--gutter) calc(3rem + var(--safe-b)); }
  .mark { display: inline-block; color: #fff; margin-bottom: 1.5rem; }
  .mark :global(svg) { height: 30px; width: auto; }
  .services { text-transform: uppercase; margin: 0; }
  address { font-style: normal; text-transform: uppercase; }
  a { text-decoration: none; }
  @media (hover: hover) { a:hover { text-decoration: underline; text-underline-offset: 3px; } }
  .legal-links { text-transform: uppercase; margin-top: 0.4rem; }
  .sep { display: inline-block; margin: 0 0.6rem; opacity: 0.6; }
  .copy { margin: 0.4rem 0 0; text-wrap: balance; }

  /* Designer credit: vertical line + kossov.it mark on the right edge (all screen sizes) */
  .site-footer { position: relative; }
  .credit--v {
    position: absolute;
    top: 3.5rem;
    bottom: 3rem;
    right: max(1.5rem, var(--safe-r));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
  }
  .credit-line {
    flex: 1;
    width: 1px;
    background: currentColor;
    opacity: 0.55;
  }
  .credit a { display: block; line-height: 0; opacity: 0.9; transition: opacity 0.3s var(--ease), transform 0.3s var(--ease); }
  .credit a:focus-visible { opacity: 1; transform: translateY(-2px); text-decoration: none; }
  @media (hover: hover) { .credit a:hover { opacity: 1; transform: translateY(-2px); text-decoration: none; } }
  .credit--v :global(svg) { width: 26px; height: auto; }

  .credit--h { display: none; }
  @media (max-width: 699px) {
    .inner { padding-bottom: 3rem; } /* the credit row below is the last element here */
    .credit--v { display: none; }
    .credit--h {
      display: block;
      margin: 0 var(--gutter);
      padding: 1.25rem 0 calc(1.5rem + var(--safe-b));
      border-top: 1px solid rgba(46, 74, 95, 0.3);
      color: var(--ink);
    }
    .credit--h a {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      width: fit-content;
      margin: 0 auto;
      line-height: 1;
    }
    .credit-label { font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; }
    .credit--h :global(svg) { width: 72px; height: auto; }
  }
  @media (max-width: 420px) {
    address .sep, address br { display: none; }
    address span { display: block; }
  }
</style>
