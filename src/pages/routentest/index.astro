---
// Temporary test page (not linked, not in the sitemap, noindex): which link types open the
// visitor's default map app on iPhone/iPad? Delete once the route button is settled.
import Layout from '../../layouts/Layout.astro';
import { practice } from '../../i18n/content';

const addr = encodeURIComponent(`${practice.street}, ${practice.zip} ${practice.city}`);
const tests = [
  { id: '1', label: 'Route (neuer Weg)', href: `geo-navigation:///directions?destination=${addr}` },
  { id: '2', label: 'Ort (neuer Weg)', href: `geo-navigation:///place?address=${addr}` },
  { id: '3', label: 'Apple-Link', href: `maps://?daddr=${addr}` },
  { id: '4', label: 'Android-Link', href: `geo:0,0?q=${addr}` },
];
---
<Layout lang="de" title="Routentest – Therapie N25" description="Interner Test." noindex>
  <article class="legal">
    <h1>Routentest</h1>
    <p>Diese Seite auf dem iPhone öffnen. Dann <strong>Test 1</strong> antippen, notieren, welche App sich öffnet,
      zurück zu dieser Seite wechseln und mit Test 2, 3 und 4 genauso weitermachen.</p>
    <p>Mögliche Ergebnisse: <strong>Google Maps</strong>, <strong>Apple Karten</strong> oder
      <strong>Fehlermeldung / nichts passiert</strong>.</p>
    <ul class="tests">
      {tests.map((t) => <li><a class="btn" href={t.href}>Test {t.id} – {t.label}</a></li>)}
    </ul>
  </article>
</Layout>

<style>
  .tests { list-style: none; padding: 0 !important; display: grid; gap: 1rem; margin-top: 2rem; }
  .tests .btn { width: 100%; justify-content: center; text-transform: none; }
</style>
