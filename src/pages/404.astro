---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/url';
---
<Layout lang="de" title="Seite nicht gefunden – Therapie N25" description="Diese Seite gibt es nicht (mehr)." noindex>
  <article class="legal not-found">
    <h1>Seite nicht gefunden</h1>
    <p>Die gesuchte Seite gibt es leider nicht (mehr).</p>
    <p><a class="btn" href={url('/')}>Zur Startseite</a></p>
    <p class="en" lang="en">Page not found – <a href={url('/en/')}>go to the English homepage</a>.</p>
  </article>
</Layout>

<style>
  .not-found { text-align: center; }
  .not-found .btn { margin: 1.5rem 0 2.5rem; }
  .en { color: var(--text-soft); font-size: 0.95rem; }
</style>
